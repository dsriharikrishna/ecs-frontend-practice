# This frontend uses mock data only; no runtime environment variables are required.
#
# Deployment settings for .github/workflows/deploy-ecs.yml.
# These are GitHub Actions secrets, not frontend runtime settings.
# Add the values to GitHub Actions secrets; do not commit credentials.
# AWS_ROLE_ARN must identify an IAM role trusted by GitHub OIDC, not an IAM user.

AWS_ROLE_ARN=arn:aws:iam::750907156533:role/GitHubActionsDeploy
AWS_REGION=ap-south-2
ECR_REPOSITORY=ecr-frontend-img
ECS_CLUSTER=arn:aws:ecs:ap-south-2:750907156533:cluster/ecs-frontend-practice
ECS_SERVICE=ecs-frontend-practice-service-79cgujk6
ECS_TASK_DEFINITION=ecs-frontend-practice
ECS_CONTAINER_NAME=Main
